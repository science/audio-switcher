#!/bin/bash
# audio-switcher — PipeWire auto-routing daemon
#
# Detects Sennheiser BTD-800 headset connection via HID reports from
# the USB dongle's hidraw device, then sets PipeWire audio defaults:
#   - Headset connected  → BTD-800 as default sink + source
#   - Headset disconnected → S/PDIF speakers as default sink
#
# The BTD-800 dongle handles Bluetooth internally. PipeWire/ALSA never
# see connection events. The dongle's HID interface (Report ID 1) sends
# a vendor report on connect/disconnect. Byte 19 is the connection flag:
#   0x01 = connected, 0x00 = disconnected.
#
# Run interactively:  ./audio-switcher [-v|--verbose]
# Install as service: ./install.sh

set -euo pipefail

# --- Constants ---
BTD_USB_ID="usb-1395_Sennheiser_BTD_800_USB-00"    # stable USB vendor/product match pattern
SPDIF_SINK="alsa_output.pci-0000_00_1f.3.iec958-stereo"

# HID report parsing: vendor report ID 1, byte 19 = connection flag
BTD_HID_REPORT_ID=1
BTD_HID_CONNECT_BYTE=19  # 0-indexed within full report (including report ID byte)

# PipeWire recovery: detect broken-pipe errors and restart PipeWire
PW_ERROR_THRESHOLD=5         # broken-pipe errors in check window to trigger restart
PW_CHECK_WINDOW="30s"        # how far back to look in the journal
PW_COOLDOWN_SECONDS=300      # minimum seconds between restarts (5 minutes)
PW_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-pw-cooldown"

# State file: IPC between HID event loop and health check loop
# (background subshells can't share variables — state file is simplest IPC)
STATE_FILE="${XDG_RUNTIME_DIR}/audio-switcher-state"

# Delays
SETTLE_DELAY=0.3

VERBOSE=false
if [[ "${1:-}" == "--verbose" || "${1:-}" == "-v" ]]; then
    VERBOSE=true
fi

# --- Logging ---
log() {
    echo "$(date '+%H:%M:%S'): $*"
}

debug() {
    if [[ "$VERBOSE" == true ]]; then
        echo "$(date '+%H:%M:%S'): [debug] $*"
    fi
}

# --- Find BTD-800 hidraw device ---
find_hidraw() {
    local hidraw
    for hidraw in /dev/hidraw*; do
        [[ -e "$hidraw" ]] || continue
        local vid pid
        # Walk sysfs to match vendor/product
        local sysdev="/sys/class/hidraw/$(basename "$hidraw")/device"
        if [[ -d "$sysdev" ]]; then
            # Try to find idVendor/idProduct in parent USB device
            vid=$(cat "$sysdev/../../idVendor" 2>/dev/null || true)
            pid=$(cat "$sysdev/../../idProduct" 2>/dev/null || true)
            if [[ "$vid" == "1395" && "$pid" == "002d" ]]; then
                echo "$hidraw"
                return 0
            fi
        fi
    done
    return 1
}

# --- BTD-800 PipeWire Device Discovery ---
find_btd_sink() {
    pactl list sinks short 2>/dev/null | grep "$BTD_USB_ID" | awk '{print $2}' | head -1 || true
}

find_btd_source() {
    pactl list sources short 2>/dev/null | grep "$BTD_USB_ID" | grep -v '\.monitor' | awk '{print $2}' | head -1 || true
}

# --- BTD-800 Card Profile Management ---
# Ensure the BTD-800 card profile includes mic input.
# If active profile is output-only (e.g. "output:analog-stereo"), switch to
# the variant with input (e.g. "output:analog-stereo+input:mono-fallback").
ensure_btd_input_profile() {
    local card="alsa_card.${BTD_USB_ID}"
    local active_profile
    active_profile=$(pactl list cards 2>/dev/null \
        | sed -n "/Name: $card/,/^$/p" \
        | grep "Active Profile:" | sed 's/.*: //' || true)

    if [[ -z "$active_profile" ]]; then
        log "WARNING: BTD-800 card not found, cannot set profile"
        return
    fi

    # If active profile already has input, nothing to do
    if [[ "$active_profile" == *"+input:"* ]]; then
        debug "profile already includes input ($active_profile)"
        return
    fi

    # Switch to the same output profile but with mic input
    local with_input="${active_profile}+input:mono-fallback"
    if pactl set-card-profile "$card" "$with_input" 2>/dev/null; then
        log "PROFILE: switched to $with_input (added mic input)"
    else
        log "WARNING: failed to set profile $with_input"
    fi
}

# --- Core Logic ---
apply_defaults() {
    local connected="$1"
    local current_sink current_source

    current_sink=$(pactl get-default-sink 2>/dev/null || true)
    current_source=$(pactl get-default-source 2>/dev/null || true)

    if [[ "$connected" == "true" ]]; then
        # Ensure card profile includes mic input before discovering devices
        ensure_btd_input_profile

        # Headset connected → discover BTD-800 sink/source dynamically
        local btd_sink btd_source
        btd_sink=$(find_btd_sink)
        btd_source=$(find_btd_source)

        if [[ -z "$btd_sink" ]]; then
            log "WARNING: BTD-800 sink not found by PipeWire (device not enumerated yet?)"
        elif [[ "$current_sink" != "$btd_sink" ]]; then
            if pactl set-default-sink "$btd_sink" 2>/dev/null; then
                log "SWITCH sink → BTD-800 headset ($btd_sink)"
            else
                log "ERROR: failed to set BTD-800 as default sink ($btd_sink)"
            fi
        else
            debug "sink already BTD-800 ($btd_sink), no change"
        fi

        if [[ -z "$btd_source" ]]; then
            log "WARNING: BTD-800 source not found by PipeWire (device not enumerated yet?)"
        elif [[ "$current_source" != "$btd_source" ]]; then
            if pactl set-default-source "$btd_source" 2>/dev/null; then
                log "SWITCH source → BTD-800 mic ($btd_source)"
            else
                log "ERROR: failed to set BTD-800 as default source ($btd_source)"
            fi
        else
            debug "source already BTD-800 ($btd_source), no change"
        fi
    else
        # Headset disconnected → S/PDIF fallback
        if [[ "$current_sink" != "$SPDIF_SINK" ]]; then
            if pactl set-default-sink "$SPDIF_SINK" 2>/dev/null; then
                log "SWITCH sink → S/PDIF speakers"
            else
                log "ERROR: failed to set S/PDIF as default sink"
            fi
        else
            debug "sink already S/PDIF, no change"
        fi
        # No explicit fallback source — let PipeWire choose
    fi
}

show_status() {
    local default_sink default_source
    default_sink=$(pactl get-default-sink 2>/dev/null || echo "(unknown)")
    default_source=$(pactl get-default-source 2>/dev/null || echo "(unknown)")
    log "  Default sink:   $default_sink"
    log "  Default source: $default_source"
}

# --- State File IPC ---
write_state() {
    echo "$1" > "$STATE_FILE"
}

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "unknown"
    fi
}

# --- PipeWire Health Monitor ---
check_pipewire_health() {
    # Check cooldown — don't restart too frequently
    if [[ -f "$PW_COOLDOWN_FILE" ]]; then
        local last_restart now
        last_restart=$(cat "$PW_COOLDOWN_FILE")
        now=$(date +%s)
        if (( now - last_restart < PW_COOLDOWN_SECONDS )); then
            return 0
        fi
    fi

    # Count broken-pipe errors in the check window
    local error_count
    error_count=$(journalctl --user -u pipewire --since "-${PW_CHECK_WINDOW}" --no-pager 2>/dev/null \
        | grep -c "Broken pipe" || true)

    if (( error_count >= PW_ERROR_THRESHOLD )); then
        log "PW-RECOVERY: $error_count broken-pipe errors in last ${PW_CHECK_WINDOW}, restarting PipeWire"
        systemctl --user restart pipewire pipewire-pulse wireplumber

        # Record restart time for cooldown
        date +%s > "$PW_COOLDOWN_FILE"

        # Give PipeWire time to enumerate devices, then re-apply correct defaults
        sleep 2
        local state
        state=$(read_state)
        if [[ "$state" == "connected" ]]; then
            apply_defaults true
        else
            apply_defaults false
        fi
        log "PW-RECOVERY: defaults re-applied (state=$state)"
        show_status
    fi
}

pipewire_health_loop() {
    while true; do
        sleep 30
        check_pipewire_health || true
    done
}

# --- Rapid Health Check (post-connect) ---
# Runs ~10 checks at ~3s intervals after a connect event.
# More aggressive than the background health loop: threshold=1 (any broken pipe triggers restart).
rapid_health_check() {
    local since_time="$1"
    local checks=10
    local interval=3
    for ((i=0; i<checks; i++)); do
        sleep "$interval"
        local error_count
        error_count=$(journalctl --user -u pipewire --since "$since_time" --no-pager 2>/dev/null \
            | grep -c "Broken pipe" || true)
        if (( error_count > 0 )); then
            log "RAPID-CHECK: $error_count broken-pipe errors since connect, restarting PipeWire"
            systemctl --user restart pipewire pipewire-pulse wireplumber
            date +%s > "$PW_COOLDOWN_FILE"
            sleep 2
            local state
            state=$(read_state)
            apply_defaults "$([ "$state" = "connected" ] && echo true || echo false)"
            log "RAPID-CHECK: recovery complete, defaults re-applied"
            show_status
            return
        fi
    done
    debug "rapid health checks complete, no issues found"
}

# --- Sleep/Resume Monitor ---
# Watches systemd-logind D-Bus signal for resume events.
# On wake from sleep, re-applies defaults and runs rapid health checks
# (PipeWire streams often break when USB devices lose power during suspend).
sleep_resume_loop() {
    gdbus monitor --system --dest org.freedesktop.login1 \
        --object-path /org/freedesktop/login1 2>/dev/null \
    | while IFS= read -r line; do
        if [[ "$line" == *"PrepareForSleep"*"false"* ]]; then
            log "RESUME: system woke from sleep, re-applying defaults"
            sleep 2  # give PipeWire a moment to re-enumerate devices
            local state
            state=$(read_state)
            apply_defaults "$([ "$state" = "connected" ] && echo true || echo false)"
            show_status
            log "RESUME: starting rapid health checks"
            rapid_health_check "$(date '+%Y-%m-%d %H:%M:%S')"
        fi
    done
}

# --- HID Monitor ---
# Reads BTD-800 hidraw device and calls apply_defaults on connection changes.
# Uses a small Python helper for binary HID report parsing.
monitor_hidraw() {
    local hidraw="$1"
    python3 -u -c "
import os, select, sys

REPORT_ID = $BTD_HID_REPORT_ID
CONNECT_BYTE = $BTD_HID_CONNECT_BYTE

fd = os.open('$hidraw', os.O_RDONLY)
try:
    while True:
        r, _, _ = select.select([fd], [], [])
        if r:
            data = os.read(fd, 256)
            if not data:
                break
            report_id = data[0]
            if report_id == REPORT_ID and len(data) > CONNECT_BYTE:
                connected = data[CONNECT_BYTE]
                # Output: 'connected' or 'disconnected'
                if connected:
                    print('connected', flush=True)
                else:
                    print('disconnected', flush=True)
except Exception as e:
    print(f'error:{e}', file=sys.stderr, flush=True)
finally:
    os.close(fd)
" 2>&1
}

# --- Main Event Loop ---
event_loop() {
    local hidraw="$1"

    while true; do
        log "Starting HID monitor on $hidraw..."
        show_status

        while IFS= read -r event; do
            case "$event" in
                connected)
                    log "EVENT: headset connected"
                    sleep "$SETTLE_DELAY"
                    write_state "connected"
                    apply_defaults true
                    show_status
                    # Kill any previous rapid-check, start new one
                    [[ -n "${RAPID_PID:-}" ]] && kill "$RAPID_PID" 2>/dev/null || true
                    rapid_health_check "$(date '+%Y-%m-%d %H:%M:%S')" &
                    RAPID_PID=$!
                    ;;
                disconnected)
                    # Kill rapid-check if running (no point checking after disconnect)
                    [[ -n "${RAPID_PID:-}" ]] && kill "$RAPID_PID" 2>/dev/null || true
                    RAPID_PID=""
                    log "EVENT: headset disconnected"
                    sleep "$SETTLE_DELAY"
                    write_state "disconnected"
                    apply_defaults false
                    show_status
                    ;;
                error:*)
                    log "HID error: ${event#error:}"
                    ;;
                *)
                    debug "unknown event: $event"
                    ;;
            esac
        done < <(monitor_hidraw "$hidraw")

        # monitor_hidraw exited — device may have been unplugged
        log "HID monitor disconnected, waiting 2s before retrying..."
        sleep 2
    done
}

# --- Signal Handling ---
cleanup() {
    trap - SIGTERM SIGINT
    echo ""
    log "Shutting down audio-switcher"
    # Kill health loop, sleep monitor, rapid-check, and any other background jobs
    if [[ -n "${HEALTH_PID:-}" ]]; then
        kill "$HEALTH_PID" 2>/dev/null || true
    fi
    if [[ -n "${SLEEP_PID:-}" ]]; then
        kill "$SLEEP_PID" 2>/dev/null || true
    fi
    if [[ -n "${RAPID_PID:-}" ]]; then
        kill "$RAPID_PID" 2>/dev/null || true
    fi
    jobs -p | xargs -r kill 2>/dev/null || true
    # Clean up runtime files
    rm -f "$STATE_FILE" "$PW_COOLDOWN_FILE"
    exit 0
}

trap cleanup SIGTERM SIGINT

# --- Main ---
log "audio-switcher starting (verbose=$VERBOSE)"
log "  BTD-800 match:   *${BTD_USB_ID}*"
log "  BTD-800 sink:    $(find_btd_sink)"
log "  BTD-800 source:  $(find_btd_source)"
log "  S/PDIF fallback: $SPDIF_SINK"

# Find the hidraw device
HIDRAW=$(find_hidraw) || {
    log "ERROR: BTD-800 hidraw device not found. Is the dongle plugged in?"
    log "  Ensure a udev rule grants access: see install.sh"
    exit 1
}
log "  HID device:      $HIDRAW"

# Check read access
if [[ ! -r "$HIDRAW" ]]; then
    log "ERROR: Cannot read $HIDRAW (permission denied)"
    log "  Install the udev rule: sudo cp 70-btd800.rules /etc/udev/rules.d/"
    log "  Then: sudo udevadm control --reload-rules && sudo udevadm trigger"
    exit 1
fi

echo ""

# Start PipeWire health monitor in background
pipewire_health_loop &
HEALTH_PID=$!
log "  PW health monitor PID: $HEALTH_PID"

# Start sleep/resume monitor in background
sleep_resume_loop &
SLEEP_PID=$!
log "  Sleep/resume monitor PID: $SLEEP_PID"

event_loop "$HIDRAW"
