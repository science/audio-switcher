#!/bin/bash
# audio-switcher — PipeWire auto-routing daemon
#
# Detects Sennheiser BTD-800 headset link state via HID reports from the USB
# dongle's hidraw device, then sets PipeWire audio defaults:
#   - Headset linked     → BTD-800 as default sink AND source (a matched pair)
#   - Headset not linked → S/PDIF speakers as default sink (no matching mic)
#
# The dongle handles Bluetooth internally — PipeWire/ALSA never see the headset
# connect/disconnect, only the dongle (its sink exists and goes RUNNING either
# way). The dongle's HID interface sends vendor Report ID 1 on link change;
# byte 19 is the connection flag: 0x01 = connected, 0x00 = disconnected.
#
# Keeping the default SINK and SOURCE matched to the SAME device is the core
# job — the OS and apps routinely mismatch headset speaker/mic on their own.
#
# Run interactively:  ./audio-switcher [-v|--verbose] | fix
# Install as service: ./install.sh

set -euo pipefail

# --- Device Constants ---
BTD_USB_ID="usb-1395_Sennheiser_BTD_800_USB-00"    # stable BTD-800 sink/source/card match pattern
SPDIF_SINK="alsa_output.pci-0000_00_1f.3.iec958-stereo"

# HID report parsing — BTD-800: vendor report ID 1, byte 19 = connection flag
BTD_HID_REPORT_ID=1
BTD_HID_CONNECT_BYTE=19  # 0-indexed within full report (including report ID byte)

# PipeWire recovery: detect broken-pipe errors and restart PipeWire
PW_ERROR_THRESHOLD=5         # broken-pipe errors in check window to trigger restart
PW_CHECK_WINDOW="30s"        # how far back to look in the journal
PW_COOLDOWN_SECONDS=300      # minimum seconds between restarts (5 minutes)
PW_HUNT_DURATION=300         # hunt mode duration (5 minutes)
PW_HUNT_INTERVAL=10          # hunt mode check interval (seconds)
PW_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-pw-cooldown"
PW_NOTIFY_COOLDOWN_SECONDS=300  # max one restart notification per 5 minutes
PW_NOTIFY_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-notify-cooldown"

# State file: headset connection state, shared with the background loops.
# Format: key=value lines, e.g. "btd=connected" / "btd=disconnected".
# (Background subshells can't share variables — a state file is the simplest IPC.)
# Overridable via environment so tests can point it at a temp file.
STATE_FILE="${STATE_FILE:-${XDG_RUNTIME_DIR}/audio-switcher-state}"

# Desktop default-sink resync. Cinnamon's volume keys (csd-media-keys) and
# sound applet keep their own copy of the default sink (libcvc), updated only
# by pipewire-pulse change events. During some screen locks every sound card
# disappears; at unlock they all return at once, pulse first reports the sink
# WirePlumber ranks highest as default, then the configured one, and sometimes
# sends no event for that second step (2026-10-24, twice). The volume keys
# then drive a headset while S/PDIF plays. Setting the same default again
# sends no event either, so a re-created default sink is re-announced by
# switching to a throwaway null sink and straight back.
DESKTOP_RESYNC_SINK="audio_switcher_resync"
DESKTOP_SYNC_SETTLE=2          # seconds without a new sink before checking
LAST_DEFAULT_SINK=""           # "<name> <index>" of the last real default sink

# Delays
SETTLE_DELAY=0.3

VERBOSE=false
ACTION="daemon"

# --- Logging ---
log() {
    echo "$(date '+%H:%M:%S'): $*"
}

debug() {
    if [[ "$VERBOSE" == true ]]; then
        echo "$(date '+%H:%M:%S'): [debug] $*"
    fi
}

# --- Desktop Notifications ---
notify_user() {
    local urgency="$1" title="$2" body="$3"
    notify-send -u "$urgency" -a "audio-switcher" "$title" "$body" 2>/dev/null || true
}

# --- PipeWire Restart Notification (cooldown-guarded) ---
notify_pw_restart() {
    local reason="$1"
    local now
    now=$(date +%s)

    if [[ -f "$PW_NOTIFY_COOLDOWN_FILE" ]]; then
        local last_notify
        last_notify=$(cat "$PW_NOTIFY_COOLDOWN_FILE")
        if (( now - last_notify < PW_NOTIFY_COOLDOWN_SECONDS )); then
            debug "suppressing restart notification (cooldown active)"
            return 0
        fi
    fi

    echo "$now" > "$PW_NOTIFY_COOLDOWN_FILE"
    notify_user critical "PipeWire Restarted" \
        "$reason\nApps like Slack may need to be restarted to restore audio."
    log "NOTIFY: PipeWire restart notification sent"
}

# --- hidraw discovery ---
# Find a hidraw device by USB vendor:product (BTD-800) — walks sysfs.
find_hidraw() {
    local hidraw
    for hidraw in /dev/hidraw*; do
        [[ -e "$hidraw" ]] || continue
        local vid pid
        local sysdev="/sys/class/hidraw/$(basename "$hidraw")/device"
        if [[ -d "$sysdev" ]]; then
            vid=$(cat "$sysdev/../../idVendor" 2>/dev/null || true)
            pid=$(cat "$sysdev/../../idProduct" 2>/dev/null || true)
            if [[ "$vid" == "1395" && "$pid" == "002d" ]]; then
                echo "$hidraw"
                return 0
            fi
        fi
    done
    return 1
}

# --- PipeWire device discovery ---
find_btd_sink() {
    pactl list sinks short 2>/dev/null | grep "$BTD_USB_ID" | awk '{print $2}' | head -1 || true
}

find_btd_source() {
    pactl list sources short 2>/dev/null | grep "$BTD_USB_ID" | grep -v '\.monitor' | awk '{print $2}' | head -1 || true
}

# --- Card Profile Management ---
# Ensure a card's active profile includes mic input. If output-only
# (e.g. "output:analog-stereo"), switch to the "+input:mono-fallback" variant
# so the device exposes a source to pair with its sink.
ensure_btd_input_profile() {
    local card="alsa_card.${BTD_USB_ID}"
    local active_profile
    active_profile=$(pactl list cards 2>/dev/null \
        | sed -n "/Name: $card/,/^$/p" \
        | grep "Active Profile:" | sed 's/.*: //' || true)

    if [[ -z "$active_profile" ]]; then
        log "WARNING: BTD-800 card not found, cannot set profile"
        return
    fi

    if [[ "$active_profile" == *"+input:"* ]]; then
        debug "BTD profile already includes input ($active_profile)"
        return
    fi

    local with_input="${active_profile}+input:mono-fallback"
    if pactl set-card-profile "$card" "$with_input" 2>/dev/null; then
        log "PROFILE: BTD switched to $with_input (added mic input)"
    else
        log "WARNING: failed to set BTD profile $with_input"
    fi
}

# --- State File IPC (per-device) ---
set_device_state() {
    local device="$1" state="$2"
    local tmp
    tmp=$(mktemp "${STATE_FILE}.XXXXXX")
    # Preserve other devices' lines; replace this device's line.
    if [[ -f "$STATE_FILE" ]]; then
        grep -v "^${device}=" "$STATE_FILE" > "$tmp" 2>/dev/null || true
    fi
    echo "${device}=${state}" >> "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

get_device_state() {
    local device="$1" line=""
    [[ -f "$STATE_FILE" ]] && line=$(grep "^${device}=" "$STATE_FILE" 2>/dev/null | tail -1)
    if [[ -n "$line" ]]; then
        echo "${line#*=}"
    else
        echo "disconnected"
    fi
}

# Resolve the active device: btd when the headset is linked, else none.
resolve_active_device() {
    if [[ "$(get_device_state btd)" == "connected" ]]; then
        echo "btd"
    else
        echo "none"
    fi
}

# --- Routing ---
# Set default sink AND source to a matched pair, logging changes only.
apply_sink_source() {
    local label="$1" sink="$2" source="$3" cur_sink="$4" cur_source="$5"

    if [[ -z "$sink" ]]; then
        log "WARNING: $label sink not found by PipeWire (not enumerated yet?)"
    elif [[ "$cur_sink" != "$sink" ]]; then
        if pactl set-default-sink "$sink" 2>/dev/null; then
            log "SWITCH sink → $label ($sink)"
        else
            log "ERROR: failed to set $label as default sink ($sink)"
        fi
    else
        debug "sink already $label ($sink), no change"
    fi

    if [[ -z "$source" ]]; then
        log "WARNING: $label source not found by PipeWire (not enumerated yet?)"
    elif [[ "$cur_source" != "$source" ]]; then
        if pactl set-default-source "$source" 2>/dev/null; then
            log "SWITCH source → $label ($source)"
        else
            log "ERROR: failed to set $label as default source ($source)"
        fi
    else
        debug "source already $label ($source), no change"
    fi
}

# Fall back to S/PDIF speakers (output only — no matching mic; leave source).
# Retries to ride out PipeWire re-enumeration after a restart/resume.
apply_spdif_sink() {
    local current_sink="$1"
    if [[ "$current_sink" == "$SPDIF_SINK" ]]; then
        debug "sink already S/PDIF, no change"
        return
    fi
    local attempts=0 max_attempts=5
    while (( attempts < max_attempts )); do
        if pactl set-default-sink "$SPDIF_SINK" 2>/dev/null; then
            log "SWITCH sink → S/PDIF speakers"
            return
        fi
        attempts=$((attempts + 1))
        if (( attempts < max_attempts )); then
            debug "S/PDIF sink not available, retrying ($attempts/$max_attempts)..."
            sleep 1
        fi
    done
    log "ERROR: failed to set S/PDIF as default sink after $max_attempts attempts"
}

# Apply the matched sink+source for the active device, or S/PDIF.
apply_priority() {
    local active current_sink current_source
    active=$(resolve_active_device)
    current_sink=$(pactl get-default-sink 2>/dev/null || true)
    current_source=$(pactl get-default-source 2>/dev/null || true)

    case "$active" in
        btd)
            ensure_btd_input_profile
            apply_sink_source "BTD-800 headset" "$(find_btd_sink)" "$(find_btd_source)" \
                "$current_sink" "$current_source"
            ;;
        none)
            apply_spdif_sink "$current_sink"
            ;;
    esac
}

show_status() {
    local default_sink default_source
    default_sink=$(pactl get-default-sink 2>/dev/null || echo "(unknown)")
    default_source=$(pactl get-default-source 2>/dev/null || echo "(unknown)")
    log "  Active device:  $(resolve_active_device)"
    log "  Default sink:   $default_sink"
    log "  Default source: $default_source"
}

# --- Desktop Default-Sink Resync ---
# "<name> <index>" of the current default sink ("" if it is not listed).
default_sink_identity() {
    local name
    name=$(pactl get-default-sink 2>/dev/null || true)
    [[ -n "$name" ]] || return 0
    pactl list sinks short 2>/dev/null | awk -v n="$name" '$2 == n {print n, $1; exit}' || true
}

# Make libcvc clients (volume keys, sound applet) pick up <sink> again by
# switching the default to a throwaway null sink and back.
resync_desktop_default_sink() {
    local sink="$1" module
    module=$(pactl load-module module-null-sink "sink_name=$DESKTOP_RESYNC_SINK" \
        "sink_properties=device.description=audio-switcher-resync" 2>/dev/null || true)
    if [[ -z "$module" ]]; then
        log "WARNING: could not load the resync null sink; volume keys may drive the wrong sink"
        return 0
    fi
    if pactl set-default-sink "$DESKTOP_RESYNC_SINK" 2>/dev/null; then
        sleep "$SETTLE_DELAY"
        # Restore only if no routing switch landed meanwhile.
        if [[ "$(pactl get-default-sink 2>/dev/null || true)" == "$DESKTOP_RESYNC_SINK" ]]; then
            pactl set-default-sink "$sink" 2>/dev/null \
                || log "ERROR: failed to restore default sink $sink after resync"
            sleep "$SETTLE_DELAY"
        fi
    fi
    pactl unload-module "$module" 2>/dev/null || true
    log "RESYNC: default sink $sink was re-created; re-announced it so volume keys follow it"
}

# Compare the default sink with the last one seen: same name but a new index
# means it was re-created, so re-announce it. auto_null (every card gone) and
# an unlisted default are skipped, so the unlock still compares against the
# sink from before the lock.
sync_desktop_default_sink() {
    local now name
    now=$(default_sink_identity)
    name="${now% *}"
    case "$name" in
        ""|auto_null|"$DESKTOP_RESYNC_SINK") return 0 ;;
    esac
    if [[ -n "$LAST_DEFAULT_SINK" && "$name" == "${LAST_DEFAULT_SINK% *}" \
          && "$now" != "$LAST_DEFAULT_SINK" ]]; then
        resync_desktop_default_sink "$name"
    fi
    LAST_DEFAULT_SINK="$now"
}

# Read new-sink event lines; check once per burst, after DESKTOP_SYNC_SETTLE
# quiet seconds (cards come back together, and pulse settles its default
# within milliseconds of the last one).
desktop_sync_watch() {
    local line
    while IFS= read -r line; do
        while IFS= read -r -t "$DESKTOP_SYNC_SETTLE" line; do :; done
        sync_desktop_default_sink
    done
}

desktop_sync_loop() {
    while true; do
        # Also catches sinks re-created while we were not subscribed
        # (pipewire-pulse restart ends the subscription).
        sync_desktop_default_sink
        desktop_sync_watch < <(pactl subscribe 2>/dev/null | grep --line-buffered "'new' on sink #")
        sleep 2
    done
}

# --- Hunt Mode State ---
# Cooldown file format: "<timestamp> <mode>" where mode is "hunt" or "normal"
read_cooldown_state() {
    LAST_RESTART=0
    CURRENT_MODE="normal"
    if [[ -f "$PW_COOLDOWN_FILE" ]]; then
        read -r LAST_RESTART CURRENT_MODE < "$PW_COOLDOWN_FILE" || true
        CURRENT_MODE="${CURRENT_MODE:-normal}"
    fi
}

# --- PipeWire Health Monitor ---
check_pipewire_health() {
    local threshold="${1:-$PW_ERROR_THRESHOLD}"

    read_cooldown_state

    if [[ "$CURRENT_MODE" == "normal" && "$LAST_RESTART" -gt 0 ]]; then
        local now
        now=$(date +%s)
        if (( now - LAST_RESTART < PW_COOLDOWN_SECONDS )); then
            return 0
        fi
    fi

    local error_count
    error_count=$(journalctl --user -u pipewire --since "-${PW_CHECK_WINDOW}" --no-pager 2>/dev/null \
        | grep -c "Broken pipe" || true)

    if (( error_count >= threshold )); then
        log "PW-RECOVERY: $error_count broken-pipe errors in last ${PW_CHECK_WINDOW} (mode=$CURRENT_MODE, threshold=$threshold), restarting PipeWire"
        systemctl --user restart pipewire pipewire-pulse wireplumber

        echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"

        # Give PipeWire time to enumerate devices, then re-apply correct defaults.
        sleep 2
        apply_priority
        log "PW-RECOVERY: defaults re-applied (active=$(resolve_active_device))"
        show_status
        notify_pw_restart "PipeWire restarted ($error_count broken pipe errors)"
    fi
}

pipewire_health_loop() {
    while true; do
        read_cooldown_state

        local interval=30
        local threshold=$PW_ERROR_THRESHOLD

        if [[ "$CURRENT_MODE" == "hunt" ]]; then
            local now
            now=$(date +%s)
            if (( now - LAST_RESTART >= PW_HUNT_DURATION )); then
                log "HUNT: ${PW_HUNT_DURATION}s clean, returning to normal mode"
                echo "$(date +%s) normal" > "$PW_COOLDOWN_FILE"
            else
                interval=$PW_HUNT_INTERVAL
                threshold=1
            fi
        fi

        sleep "$interval"
        check_pipewire_health "$threshold" || true
    done
}

# --- Sleep/Resume Monitor ---
# On wake from sleep, re-applies defaults and enters hunt mode (PipeWire
# streams often break when USB devices lose power during suspend).
sleep_resume_loop() {
    gdbus monitor --system --dest org.freedesktop.login1 \
        --object-path /org/freedesktop/login1 2>/dev/null \
    | while IFS= read -r line; do
        if [[ "$line" == *"PrepareForSleep"*"false"* ]]; then
            log "RESUME: system woke from sleep, re-applying defaults"
            sleep 2  # give PipeWire a moment to re-enumerate devices
            apply_priority
            show_status
            log "RESUME: entering hunt mode for post-resume monitoring"
            echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"
        fi
    done
}

# --- HID Monitors ---
# Each emits 'connected' / 'disconnected' lines on stdout; the event loop
# prefixes them with the device tag.
monitor_hidraw() {
    local hidraw="$1"
    python3 -u -c "
import os, select, sys

REPORT_ID = $BTD_HID_REPORT_ID
CONNECT_BYTE = $BTD_HID_CONNECT_BYTE

fd = os.open('$hidraw', os.O_RDONLY)
try:
    while True:
        r, _, _ = select.select([fd], [], [])
        if r:
            data = os.read(fd, 256)
            if not data:
                break
            report_id = data[0]
            if report_id == REPORT_ID and len(data) > CONNECT_BYTE:
                connected = data[CONNECT_BYTE]
                if connected:
                    print('connected', flush=True)
                else:
                    print('disconnected', flush=True)
except Exception as e:
    print(f'error:{e}', file=sys.stderr, flush=True)
finally:
    os.close(fd)
" 2>&1
}

# --- Main Event Loop ---
# On a headset event, update its state, re-resolve, and apply the defaults.
handle_event() {
    local device="$1" state="$2"
    case "$state" in
        connected)
            log "EVENT: $device connected"
            sleep "$SETTLE_DELAY"
            set_device_state "$device" connected
            apply_priority
            show_status
            # Newly connected devices are prone to broken pipes — enter hunt mode.
            log "HUNT: entering hunt mode after $device connect"
            echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"
            ;;
        disconnected)
            log "EVENT: $device disconnected"
            sleep "$SETTLE_DELAY"
            set_device_state "$device" disconnected
            apply_priority
            show_status
            ;;
    esac
}

# Discover the dongle's hidraw device and monitor it. If the dongle is absent,
# wait for it; if the monitor exits (dongle unplugged), re-discover.
event_loop() {
    while true; do
        local hidraw
        hidraw=$(find_hidraw 2>/dev/null || true)

        if [[ -z "$hidraw" ]]; then
            debug "BTD-800 dongle not found; re-checking in 10s"
            sleep 10
            continue
        fi

        if [[ ! -r "$hidraw" ]]; then
            log "ERROR: cannot read $hidraw (permission denied); install the udev rule: ./install.sh, then replug the dongle. Retrying in 10s"
            sleep 10
            continue
        fi

        log "Starting HID monitor on $hidraw"
        show_status

        while IFS= read -r event; do
            case "$event" in
                connected)    handle_event btd connected ;;
                disconnected) handle_event btd disconnected ;;
                error:*)      log "HID error: ${event#error:}" ;;
                *)            debug "unknown event: $event" ;;
            esac
        done < <(monitor_hidraw "$hidraw")

        log "HID monitor exited (dongle unplugged?), waiting 2s before re-discovering..."
        sleep 2
    done
}

# --- Signal Handling ---
cleanup() {
    trap - SIGTERM SIGINT
    echo ""
    log "Shutting down audio-switcher"
    if [[ -n "${HEALTH_PID:-}" ]]; then
        kill "$HEALTH_PID" 2>/dev/null || true
    fi
    if [[ -n "${SLEEP_PID:-}" ]]; then
        kill "$SLEEP_PID" 2>/dev/null || true
    fi
    if [[ -n "${DESKTOP_SYNC_PID:-}" ]]; then
        kill "$DESKTOP_SYNC_PID" 2>/dev/null || true
    fi
    jobs -p | xargs -r kill 2>/dev/null || true
    rm -f "$STATE_FILE" "$PW_COOLDOWN_FILE" "$PW_NOTIFY_COOLDOWN_FILE"
    exit 0
}

# --- Fix Subcommand ---
do_fix() {
    local error_count
    error_count=$(journalctl --user -u pipewire --since "-120s" --no-pager 2>/dev/null \
        | grep -c "Broken pipe" || true)

    if (( error_count > 0 )); then
        log "FIX: $error_count broken-pipe errors in last 120s, restarting PipeWire"
        systemctl --user restart pipewire pipewire-pulse wireplumber
        sleep 2
        apply_priority
        log "FIX: recovery complete"
        show_status
        notify_pw_restart "Manual fix: PipeWire restarted ($error_count broken pipe errors)"
    else
        log "FIX: no broken-pipe errors in last 120s — audio appears healthy"
        show_status
        notify_user normal "Audio Healthy" "No broken pipe errors detected"
    fi
}

# --- Main ---
main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose) VERBOSE=true; shift ;;
            fix) ACTION="fix"; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    trap cleanup SIGTERM SIGINT

    if [[ "$ACTION" == "fix" ]]; then
        do_fix
        exit 0
    fi

    log "audio-switcher starting (verbose=$VERBOSE)"
    log "  BTD-800 match:   *${BTD_USB_ID}*"
    log "  BTD-800 sink:    $(find_btd_sink)"
    log "  BTD-800 source:  $(find_btd_source)"
    log "  S/PDIF fallback: $SPDIF_SINK"
    log "  BTD-800 hidraw:  $(find_hidraw 2>/dev/null || echo '(not present; waiting for it)')"

    echo ""

    # Start PipeWire health monitor in background
    pipewire_health_loop &
    HEALTH_PID=$!
    log "  PW health monitor PID: $HEALTH_PID"

    # Start sleep/resume monitor in background
    sleep_resume_loop &
    SLEEP_PID=$!
    log "  Sleep/resume monitor PID: $SLEEP_PID"

    # Keep the desktop's cached default sink honest when sinks are re-created
    desktop_sync_loop &
    DESKTOP_SYNC_PID=$!
    log "  Default-sink resync PID: $DESKTOP_SYNC_PID"

    event_loop
}

# Only run main when executed directly — sourcing (e.g. from tests) just loads
# the functions.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi