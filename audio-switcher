#!/bin/bash
# audio-switcher — PipeWire auto-routing daemon
#
# Routes PipeWire default sink + source by a priority ladder of headsets,
# detecting each headset's link state via HID reports from its USB dongle:
#
#   1. Jabra Evolve2 buds linked to Link 390 dongle  → Jabra sink + source
#   2. else Sennheiser BTD-800 headset connected      → BTD-800 sink + source
#   3. else                                           → S/PDIF speakers (sink only)
#
# Both dongles handle their wireless link internally — PipeWire/ALSA never see
# the headset connect/disconnect, only the dongle. Each dongle's HID interface
# emits a report on connect/disconnect:
#   - BTD-800: vendor Report ID 1, byte 19 = connection flag (0x01/0x00)
#   - Jabra:   Report ID 5, header "05 00 01 00 08 0d", byte 6 = 0x01/0x02
#
# Keeping the default SINK and SOURCE matched to the SAME device is the core
# job — the OS and apps routinely mismatch headset speaker/mic on their own.
#
# Run interactively:  ./audio-switcher [-v|--verbose] | fix | probe-mic
# Install as service: ./install.sh

set -euo pipefail

# --- Device Constants ---
BTD_USB_ID="usb-1395_Sennheiser_BTD_800_USB-00"    # stable BTD-800 sink/source match pattern
SPDIF_SINK="alsa_output.pci-0000_00_1f.3.iec958-stereo"

JABRA_SINK_MATCH="Jabra_Link_390"   # stable Jabra sink/source/card match (serial suffix varies)
JABRA_VID="0b0e"                    # GN Netcom / Jabra USB vendor id (for hidraw discovery)
# The Link 390 exposes an "iec958" (digital passthrough) output that WirePlumber
# prefers by priority but which is SILENT on the buds. Force the analog output
# plus the mono mic input whenever the buds are the active device.
JABRA_PROFILE="output:analog-stereo+input:mono-fallback"

# Jabra mic probe. The buds can relink in a state where the mic delivers only
# exact digital zeros (seen 2026-10-09; a bud case-cycle fixes it, nothing on
# the host can). On each connect the daemon listens to the mic briefly and
# raises a desktop alert if it hears pure zeros. A working bud never does:
# even in a silent room it emits a faint noise floor (~85% non-zero samples);
# its only block of zeros is ~1 s while it switches into call mode.
JABRA_SOURCE_VOLUME="100%"      # mic input level forced on every connect
JABRA_PROBE_DELAY=5             # seconds after connect before probing
JABRA_PROBE_SKIP=1.5            # seconds of call-mode startup zeros to discard
JABRA_PROBE_LISTEN=5            # seconds of recording that are judged
JABRA_PROBE_RETRY_DELAY=10      # confirm "dead" once; >5 s so the dongle has left call mode
JABRA_PROBE_MIN_NONZERO_PCT=5   # below this share of non-zero samples = dead
JABRA_PROBE_VOLUME_SETTLE=8     # dongle sends call-exit volume keys ~5 s after mic closes
JABRA_PROBE_ALERT_COOLDOWN=300  # max one "mic is silent" popup per 5 minutes
# Optional override: probe this PipeWire source instead of the Jabra mic
# (testing the alert path against e.g. a null sink's monitor).
JABRA_PROBE_SOURCE="${JABRA_PROBE_SOURCE:-}"
JABRA_PROBE_WAV="${XDG_RUNTIME_DIR}/audio-switcher-mic-probe.wav"
JABRA_ALERT_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-mic-alert-cooldown"
JABRA_ALERT_FLAG_FILE="${XDG_RUNTIME_DIR}/audio-switcher-mic-alert"  # holds the alert's notification id
JABRA_PROBE_PID=""

# HID report parsing — BTD-800: vendor report ID 1, byte 19 = connection flag
BTD_HID_REPORT_ID=1
BTD_HID_CONNECT_BYTE=19  # 0-indexed within full report (including report ID byte)

# HID report parsing — Jabra: report ID 5, header bytes 05 00 01 00 08 0d,
# then byte index 6 = link flag (0x01 connected, 0x02 disconnected).
JABRA_HID_REPORT_ID=5

# PipeWire recovery: detect broken-pipe errors and restart PipeWire
PW_ERROR_THRESHOLD=5         # broken-pipe errors in check window to trigger restart
PW_CHECK_WINDOW="30s"        # how far back to look in the journal
PW_COOLDOWN_SECONDS=300      # minimum seconds between restarts (5 minutes)
PW_HUNT_DURATION=300         # hunt mode duration (5 minutes)
PW_HUNT_INTERVAL=10          # hunt mode check interval (seconds)
PW_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-pw-cooldown"
PW_NOTIFY_COOLDOWN_SECONDS=300  # max one restart notification per 5 minutes
PW_NOTIFY_COOLDOWN_FILE="${XDG_RUNTIME_DIR}/audio-switcher-notify-cooldown"

# State file: per-device connection state for priority resolution.
# Format: key=value lines, e.g. "jabra=connected" / "btd=disconnected".
# (Background subshells can't share variables — a state file is the simplest IPC.)
# Overridable via environment so tests can point it at a temp file.
STATE_FILE="${STATE_FILE:-${XDG_RUNTIME_DIR}/audio-switcher-state}"

# Delays
SETTLE_DELAY=0.3

VERBOSE=false
ACTION="daemon"

# --- Logging ---
log() {
    echo "$(date '+%H:%M:%S'): $*"
}

debug() {
    if [[ "$VERBOSE" == true ]]; then
        echo "$(date '+%H:%M:%S'): [debug] $*"
    fi
}

# --- Desktop Notifications ---
notify_user() {
    local urgency="$1" title="$2" body="$3" replace_id="${4:-}"
    local args=(-u "$urgency" -a "audio-switcher")
    [[ -n "$replace_id" ]] && args+=(-r "$replace_id")
    notify-send "${args[@]}" "$title" "$body" 2>/dev/null || true
}

# Like notify_user, but prints the notification id so a later notification can
# replace it in place (notify_user's 4th argument).
notify_user_tracked() {
    local urgency="$1" title="$2" body="$3" replace_id="${4:-}"
    local args=(-p -u "$urgency" -a "audio-switcher")
    [[ -n "$replace_id" ]] && args+=(-r "$replace_id")
    notify-send "${args[@]}" "$title" "$body" 2>/dev/null || true
}

# --- PipeWire Restart Notification (cooldown-guarded) ---
notify_pw_restart() {
    local reason="$1"
    local now
    now=$(date +%s)

    if [[ -f "$PW_NOTIFY_COOLDOWN_FILE" ]]; then
        local last_notify
        last_notify=$(cat "$PW_NOTIFY_COOLDOWN_FILE")
        if (( now - last_notify < PW_NOTIFY_COOLDOWN_SECONDS )); then
            debug "suppressing restart notification (cooldown active)"
            return 0
        fi
    fi

    echo "$now" > "$PW_NOTIFY_COOLDOWN_FILE"
    notify_user critical "PipeWire Restarted" \
        "$reason\nApps like Slack may need to be restarted to restore audio."
    log "NOTIFY: PipeWire restart notification sent"
}

# --- hidraw discovery ---
# Find a hidraw device by USB vendor:product (BTD-800) — walks sysfs.
find_hidraw() {
    local hidraw
    for hidraw in /dev/hidraw*; do
        [[ -e "$hidraw" ]] || continue
        local vid pid
        local sysdev="/sys/class/hidraw/$(basename "$hidraw")/device"
        if [[ -d "$sysdev" ]]; then
            vid=$(cat "$sysdev/../../idVendor" 2>/dev/null || true)
            pid=$(cat "$sysdev/../../idProduct" 2>/dev/null || true)
            if [[ "$vid" == "1395" && "$pid" == "002d" ]]; then
                echo "$hidraw"
                return 0
            fi
        fi
    done
    return 1
}

# Find the Jabra dongle's hidraw device by USB vendor id (device number is
# unstable across re-plug, so discover by vid, not a fixed path).
find_jabra_hidraw() {
    local hidraw
    for hidraw in /dev/hidraw*; do
        [[ -e "$hidraw" ]] || continue
        local vid
        local sysdev="/sys/class/hidraw/$(basename "$hidraw")/device"
        if [[ -d "$sysdev" ]]; then
            vid=$(cat "$sysdev/../../idVendor" 2>/dev/null || true)
            if [[ "$vid" == "$JABRA_VID" ]]; then
                echo "$hidraw"
                return 0
            fi
        fi
    done
    return 1
}

# --- PipeWire device discovery ---
find_btd_sink() {
    pactl list sinks short 2>/dev/null | grep "$BTD_USB_ID" | awk '{print $2}' | head -1 || true
}

find_btd_source() {
    pactl list sources short 2>/dev/null | grep "$BTD_USB_ID" | grep -v '\.monitor' | awk '{print $2}' | head -1 || true
}

# Prefer the analog-stereo sink: right after a profile switch PipeWire can
# transiently list the old iec958 sink alongside the new analog one.
find_jabra_sink() {
    local sinks
    sinks=$(pactl list sinks short 2>/dev/null | grep "$JABRA_SINK_MATCH" | awk '{print $2}' || true)
    { grep 'analog-stereo' <<< "$sinks"; echo "$sinks"; } | grep -v '^$' | head -1 || true
}

# Poll for the Jabra sink: a profile switch tears down and re-creates the
# sink, so an immediate lookup after ensure_jabra_input_profile can miss it.
wait_for_jabra_sink() {
    local attempts=0 max_attempts=10 sink
    while (( attempts < max_attempts )); do
        sink=$(find_jabra_sink)
        if [[ -n "$sink" ]]; then
            echo "$sink"
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 0.3
    done
    return 1
}

find_jabra_source() {
    pactl list sources short 2>/dev/null | grep "$JABRA_SINK_MATCH" | grep -v '\.monitor' | awk '{print $2}' | head -1 || true
}

find_jabra_card() {
    pactl list cards short 2>/dev/null | grep "$JABRA_SINK_MATCH" | awk '{print $2}' | head -1 || true
}

# --- Card Profile Management ---
# Ensure a card's active profile includes mic input. If output-only
# (e.g. "output:analog-stereo"), switch to the "+input:mono-fallback" variant
# so the device exposes a source to pair with its sink.
ensure_btd_input_profile() {
    local card="alsa_card.${BTD_USB_ID}"
    local active_profile
    active_profile=$(pactl list cards 2>/dev/null \
        | sed -n "/Name: $card/,/^$/p" \
        | grep "Active Profile:" | sed 's/.*: //' || true)

    if [[ -z "$active_profile" ]]; then
        log "WARNING: BTD-800 card not found, cannot set profile"
        return
    fi

    if [[ "$active_profile" == *"+input:"* ]]; then
        debug "BTD profile already includes input ($active_profile)"
        return
    fi

    local with_input="${active_profile}+input:mono-fallback"
    if pactl set-card-profile "$card" "$with_input" 2>/dev/null; then
        log "PROFILE: BTD switched to $with_input (added mic input)"
    else
        log "WARNING: failed to set BTD profile $with_input"
    fi
}

# Force the Jabra card onto JABRA_PROFILE (analog output + mono mic). Unlike
# the BTD-800, "any profile with input" is NOT good enough here: the iec958
# output variant has a mic but no audible speaker path.
ensure_jabra_input_profile() {
    local card
    card=$(find_jabra_card)
    if [[ -z "$card" ]]; then
        log "WARNING: Jabra card not found, cannot set profile"
        return
    fi

    local active_profile
    active_profile=$(pactl list cards 2>/dev/null \
        | sed -n "/Name: $card/,/^$/p" \
        | grep "Active Profile:" | sed 's/.*: //' || true)

    if [[ -z "$active_profile" ]]; then
        return
    fi

    if [[ "$active_profile" == "$JABRA_PROFILE" ]]; then
        debug "Jabra profile already $JABRA_PROFILE"
        return
    fi

    if pactl set-card-profile "$card" "$JABRA_PROFILE" 2>/dev/null; then
        log "PROFILE: Jabra switched $active_profile → $JABRA_PROFILE (analog out + mic)"
    else
        log "WARNING: failed to set Jabra profile $JABRA_PROFILE"
    fi
}

# --- State File IPC (per-device) ---
set_device_state() {
    local device="$1" state="$2"
    local tmp
    tmp=$(mktemp "${STATE_FILE}.XXXXXX")
    # Preserve other devices' lines; replace this device's line.
    if [[ -f "$STATE_FILE" ]]; then
        grep -v "^${device}=" "$STATE_FILE" > "$tmp" 2>/dev/null || true
    fi
    echo "${device}=${state}" >> "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

get_device_state() {
    local device="$1" line=""
    [[ -f "$STATE_FILE" ]] && line=$(grep "^${device}=" "$STATE_FILE" 2>/dev/null | tail -1)
    if [[ -n "$line" ]]; then
        echo "${line#*=}"
    else
        echo "disconnected"
    fi
}

# Resolve the highest-priority connected device: jabra > btd > none.
resolve_active_device() {
    if [[ "$(get_device_state jabra)" == "connected" ]]; then
        echo "jabra"
    elif [[ "$(get_device_state btd)" == "connected" ]]; then
        echo "btd"
    else
        echo "none"
    fi
}

# --- Routing ---
# Set default sink AND source to a matched pair, logging changes only.
apply_sink_source() {
    local label="$1" sink="$2" source="$3" cur_sink="$4" cur_source="$5"

    if [[ -z "$sink" ]]; then
        log "WARNING: $label sink not found by PipeWire (not enumerated yet?)"
    elif [[ "$cur_sink" != "$sink" ]]; then
        if pactl set-default-sink "$sink" 2>/dev/null; then
            log "SWITCH sink → $label ($sink)"
        else
            log "ERROR: failed to set $label as default sink ($sink)"
        fi
    else
        debug "sink already $label ($sink), no change"
    fi

    if [[ -z "$source" ]]; then
        log "WARNING: $label source not found by PipeWire (not enumerated yet?)"
    elif [[ "$cur_source" != "$source" ]]; then
        if pactl set-default-source "$source" 2>/dev/null; then
            log "SWITCH source → $label ($source)"
        else
            log "ERROR: failed to set $label as default source ($source)"
        fi
    else
        debug "source already $label ($source), no change"
    fi
}

# Fall back to S/PDIF speakers (output only — no matching mic; leave source).
# Retries to ride out PipeWire re-enumeration after a restart/resume.
apply_spdif_sink() {
    local current_sink="$1"
    if [[ "$current_sink" == "$SPDIF_SINK" ]]; then
        debug "sink already S/PDIF, no change"
        return
    fi
    local attempts=0 max_attempts=5
    while (( attempts < max_attempts )); do
        if pactl set-default-sink "$SPDIF_SINK" 2>/dev/null; then
            log "SWITCH sink → S/PDIF speakers"
            return
        fi
        attempts=$((attempts + 1))
        if (( attempts < max_attempts )); then
            debug "S/PDIF sink not available, retrying ($attempts/$max_attempts)..."
            sleep 1
        fi
    done
    log "ERROR: failed to set S/PDIF as default sink after $max_attempts attempts"
}

# Resolve the priority ladder and apply the winner's matched sink+source.
apply_priority() {
    local active current_sink current_source
    active=$(resolve_active_device)
    current_sink=$(pactl get-default-sink 2>/dev/null || true)
    current_source=$(pactl get-default-source 2>/dev/null || true)

    case "$active" in
        jabra)
            ensure_jabra_input_profile
            local jabra_sink
            jabra_sink=$(wait_for_jabra_sink || true)
            apply_sink_source "Jabra buds" "$jabra_sink" "$(find_jabra_source)" \
                "$current_sink" "$current_source"
            ;;
        btd)
            ensure_btd_input_profile
            apply_sink_source "BTD-800 headset" "$(find_btd_sink)" "$(find_btd_source)" \
                "$current_sink" "$current_source"
            ;;
        none)
            apply_spdif_sink "$current_sink"
            ;;
    esac
}

show_status() {
    local default_sink default_source
    default_sink=$(pactl get-default-sink 2>/dev/null || echo "(unknown)")
    default_source=$(pactl get-default-source 2>/dev/null || echo "(unknown)")
    log "  Active device:  $(resolve_active_device)"
    log "  Default sink:   $default_sink"
    log "  Default source: $default_source"
}

# --- Hunt Mode State ---
# Cooldown file format: "<timestamp> <mode>" where mode is "hunt" or "normal"
read_cooldown_state() {
    LAST_RESTART=0
    CURRENT_MODE="normal"
    if [[ -f "$PW_COOLDOWN_FILE" ]]; then
        read -r LAST_RESTART CURRENT_MODE < "$PW_COOLDOWN_FILE" || true
        CURRENT_MODE="${CURRENT_MODE:-normal}"
    fi
}

# --- PipeWire Health Monitor ---
check_pipewire_health() {
    local threshold="${1:-$PW_ERROR_THRESHOLD}"

    read_cooldown_state

    if [[ "$CURRENT_MODE" == "normal" && "$LAST_RESTART" -gt 0 ]]; then
        local now
        now=$(date +%s)
        if (( now - LAST_RESTART < PW_COOLDOWN_SECONDS )); then
            return 0
        fi
    fi

    local error_count
    error_count=$(journalctl --user -u pipewire --since "-${PW_CHECK_WINDOW}" --no-pager 2>/dev/null \
        | grep -c "Broken pipe" || true)

    if (( error_count >= threshold )); then
        log "PW-RECOVERY: $error_count broken-pipe errors in last ${PW_CHECK_WINDOW} (mode=$CURRENT_MODE, threshold=$threshold), restarting PipeWire"
        systemctl --user restart pipewire pipewire-pulse wireplumber

        echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"

        # Give PipeWire time to enumerate devices, then re-apply correct defaults.
        sleep 2
        apply_priority
        log "PW-RECOVERY: defaults re-applied (active=$(resolve_active_device))"
        show_status
        notify_pw_restart "PipeWire restarted ($error_count broken pipe errors)"
    fi
}

pipewire_health_loop() {
    while true; do
        read_cooldown_state

        local interval=30
        local threshold=$PW_ERROR_THRESHOLD

        if [[ "$CURRENT_MODE" == "hunt" ]]; then
            local now
            now=$(date +%s)
            if (( now - LAST_RESTART >= PW_HUNT_DURATION )); then
                log "HUNT: ${PW_HUNT_DURATION}s clean, returning to normal mode"
                echo "$(date +%s) normal" > "$PW_COOLDOWN_FILE"
            else
                interval=$PW_HUNT_INTERVAL
                threshold=1
            fi
        fi

        sleep "$interval"
        check_pipewire_health "$threshold" || true
    done
}

# --- Sleep/Resume Monitor ---
# On wake from sleep, re-applies defaults and enters hunt mode (PipeWire
# streams often break when USB devices lose power during suspend).
sleep_resume_loop() {
    gdbus monitor --system --dest org.freedesktop.login1 \
        --object-path /org/freedesktop/login1 2>/dev/null \
    | while IFS= read -r line; do
        if [[ "$line" == *"PrepareForSleep"*"false"* ]]; then
            log "RESUME: system woke from sleep, re-applying defaults"
            sleep 2  # give PipeWire a moment to re-enumerate devices
            apply_priority
            show_status
            log "RESUME: entering hunt mode for post-resume monitoring"
            echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"
        fi
    done
}

# --- HID Monitors ---
# Each emits 'connected' / 'disconnected' lines on stdout; the event loop
# prefixes them with the device tag.
monitor_hidraw() {
    local hidraw="$1"
    python3 -u -c "
import os, select, sys

REPORT_ID = $BTD_HID_REPORT_ID
CONNECT_BYTE = $BTD_HID_CONNECT_BYTE

fd = os.open('$hidraw', os.O_RDONLY)
try:
    while True:
        r, _, _ = select.select([fd], [], [])
        if r:
            data = os.read(fd, 256)
            if not data:
                break
            report_id = data[0]
            if report_id == REPORT_ID and len(data) > CONNECT_BYTE:
                connected = data[CONNECT_BYTE]
                if connected:
                    print('connected', flush=True)
                else:
                    print('disconnected', flush=True)
except Exception as e:
    print(f'error:{e}', file=sys.stderr, flush=True)
finally:
    os.close(fd)
" 2>&1
}

# Jabra: match Report ID 5 with header 05 00 01 00 08 0d, then byte[6]:
#   0x01 = buds connected, 0x02 = buds disconnected.
# (Lookalike reports begin "05 00 04 .." and also contain 08 0d — the full
# header match rejects them.)
monitor_jabra_hidraw() {
    local hidraw="$1"
    python3 -u -c "
import os, select, sys

fd = os.open('$hidraw', os.O_RDONLY)
try:
    while True:
        r, _, _ = select.select([fd], [], [])
        if r:
            data = os.read(fd, 256)
            if not data:
                break
            if (len(data) >= 10 and data[0] == 0x05 and data[1] == 0x00
                    and data[2] == 0x01 and data[3] == 0x00
                    and data[4] == 0x08 and data[5] == 0x0d):
                flag = data[6]
                if flag == 0x01:
                    print('connected', flush=True)
                elif flag == 0x02:
                    print('disconnected', flush=True)
except Exception as e:
    print(f'error:{e}', file=sys.stderr, flush=True)
finally:
    os.close(fd)
" 2>&1
}

# --- Jabra Mic Probe ---
# jabra_mic_verdict <wav>: judge a probe recording. Discards the first
# JABRA_PROBE_SKIP seconds (call-mode startup zeros) and measures the rest.
# Prints "<ok|dead|inconclusive> nonzero=<pct> rms=<dBFS> longest_zero=<s> secs=<s>".
# inconclusive = unreadable, or under 2 s left to judge; it never alerts.
jabra_mic_verdict() {
    python3 - "$1" "$JABRA_PROBE_SKIP" "$JABRA_PROBE_MIN_NONZERO_PCT" <<'PYEOF'
import array, math, sys, wave

path, skip, min_pct = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
rate, data = 48000, array.array("h")
try:
    with wave.open(path, "rb") as w:
        rate = w.getframerate()
        if w.getsampwidth() == 2 and w.getnchannels() == 1:
            data.frombytes(w.readframes(w.getnframes()))
except (OSError, EOFError, wave.Error):
    pass

seg = data[int(skip * rate):]
n = len(seg)
nonzero = longest = run = 0
for s in seg:
    if s:
        nonzero += 1
        run = 0
    else:
        run += 1
        if run > longest:
            longest = run
rms = math.sqrt(sum(s * s for s in seg) / n) if n else 0.0
pct = 100.0 * nonzero / n if n else 0.0
db = f"{20 * math.log10(rms / 32768):.1f}" if rms else "-inf"
if n < 2 * rate:
    verdict = "inconclusive"
elif pct < min_pct:
    verdict = "dead"
else:
    verdict = "ok"
print(f"{verdict} nonzero={pct:.1f} rms={db} longest_zero={longest / rate:.2f} secs={len(data) / rate:.1f}")
PYEOF
}

# record_jabra_mic <source> <secs> <out.wav>: record mono s16 from a PipeWire
# source. PipeWire shares capture, so apps already using the mic are
# unaffected. Stopped with SIGINT, not timeout's default SIGTERM, so pw-record
# finalises the WAV (SIGTERM left a truncated ~0.7 s file in testing).
record_jabra_mic() {
    local src="$1" secs="$2" out="$3"
    rm -f "$out"
    timeout -s INT "$secs" pw-record --target "$src" --rate 48000 --channels 1 --format s16 "$out" \
        >/dev/null 2>&1 || true
}

jabra_probe_source() {
    if [[ -n "$JABRA_PROBE_SOURCE" ]]; then
        echo "$JABRA_PROBE_SOURCE"
    else
        find_jabra_source
    fi
}

# jabra_mic_state <source> -> "muted" or "live"
jabra_mic_state() {
    if [[ "$(pactl get-source-mute "$1" 2>/dev/null || true)" == *yes* ]]; then
        echo muted
    else
        echo live
    fi
}

# jabra_mic_volume <source> -> first channel's volume, e.g. "47%" ("" if unknown)
jabra_mic_volume() {
    local line
    line=$(pactl get-source-volume "$1" 2>/dev/null || true)
    if [[ "$line" =~ ([0-9]+%) ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

# ensure_jabra_mic_live <source>: unmute the mic and force JABRA_SOURCE_VOLUME.
# A muted or turned-down source delivers zeros too (PipeWire applies mute and
# volume before any recorder), which would read as a dead bud. Prints the
# changes made, comma-separated ("unmuted,volume=47%->100%"), or nothing.
ensure_jabra_mic_live() {
    local src="$1" vol changes=()
    if [[ "$(jabra_mic_state "$src")" == muted ]]; then
        pactl set-source-mute "$src" 0 2>/dev/null || true
        changes+=(unmuted)
    fi
    vol=$(jabra_mic_volume "$src")
    if [[ -n "$vol" && "$vol" != "$JABRA_SOURCE_VOLUME" ]]; then
        pactl set-source-volume "$src" "$JABRA_SOURCE_VOLUME" 2>/dev/null || true
        changes+=("volume=${vol}->${JABRA_SOURCE_VOLUME}")
    fi
    local IFS=,
    echo "${changes[*]:-}"
}

# probe_jabra_mic_once <source>: record one take and judge it. Sets the global
# PROBE_RESULT (the verdict line plus "vol=<mic volume>") instead of printing,
# so the recorder runs as a direct child of the probe and stop_jabra_probe can
# end it immediately.
PROBE_RESULT=""
probe_jabra_mic_once() {
    local src="$1" secs vol
    vol=$(jabra_mic_volume "$src")
    secs=$(awk -v a="$JABRA_PROBE_SKIP" -v b="$JABRA_PROBE_LISTEN" 'BEGIN { print a + b }')
    record_jabra_mic "$src" "$secs" "$JABRA_PROBE_WAV"
    PROBE_RESULT="$(jabra_mic_verdict "$JABRA_PROBE_WAV") vol=${vol:-?}"
    rm -f "$JABRA_PROBE_WAV"
}

# Volume-drift guard. Opening and closing the mic makes the dongle enter and
# leave call mode, and it sends volume-key presses as it does (+2/-2 when
# healthy, -3/-3 when the bud is stuck). Cinnamon applies them to the default
# sink. The probe snapshots that sink's raw volume and mute and puts them back.
PROBE_SINK=""
PROBE_SINK_SNAPSHOT=""

# sink_volume_state <sink> -> "<raw volume per channel>|<yes|no>"
# (empty volume part when the sink no longer exists)
sink_volume_state() {
    local vols mute
    vols=$(pactl get-sink-volume "$1" 2>/dev/null | grep -oE '[0-9]+ /' | tr -d ' /' | tr '\n' ' ' || true)
    mute=$(pactl get-sink-mute "$1" 2>/dev/null || true)
    echo "${vols% }|${mute#Mute: }"
}

probe_snapshot_sink_volume() {
    PROBE_SINK=$(pactl get-default-sink 2>/dev/null || true)
    PROBE_SINK_SNAPSHOT=""
    if [[ -n "$PROBE_SINK" ]]; then
        PROBE_SINK_SNAPSHOT=$(sink_volume_state "$PROBE_SINK")
        if [[ -z "${PROBE_SINK_SNAPSHOT%|*}" ]]; then
            PROBE_SINK_SNAPSHOT=""
        fi
    fi
}

# Restore the snapshot if the sink still exists and its volume or mute moved.
# Trade-off: a manual change made during the probe is reverted too.
probe_restore_sink_volume() {
    local snap="$PROBE_SINK_SNAPSHOT" now vols mute
    PROBE_SINK_SNAPSHOT=""
    [[ -n "$snap" ]] || return 0
    now=$(sink_volume_state "$PROBE_SINK")
    if [[ -z "${now%|*}" || "$now" == "$snap" ]]; then
        return 0
    fi
    read -ra vols <<< "${snap%|*}"
    pactl set-sink-volume "$PROBE_SINK" "${vols[@]}" 2>/dev/null || true
    if [[ "${snap#*|}" != "${now#*|}" ]]; then
        if [[ "${snap#*|}" == yes ]]; then mute=1; else mute=0; fi
        pactl set-sink-mute "$PROBE_SINK" "$mute" 2>/dev/null || true
    fi
    log "PROBE: restored $PROBE_SINK volume after dongle volume-key drift (${now%|*} -> ${snap%|*})"
}

# Critical (stays on screen) "mic is silent" popup, cooldown-guarded. The
# flag file records that an alert is outstanding and holds its notification
# id, so the next healthy probe can replace it with "working again".
notify_jabra_mic_dead() {
    local now last="" id prev=""
    now=$(date +%s)
    [[ -f "$JABRA_ALERT_COOLDOWN_FILE" ]] && last=$(cat "$JABRA_ALERT_COOLDOWN_FILE" 2>/dev/null || true)
    [[ -f "$JABRA_ALERT_FLAG_FILE" ]] && prev=$(cat "$JABRA_ALERT_FLAG_FILE" 2>/dev/null || true)
    if [[ "$last" =~ ^[0-9]+$ ]] && (( now - last < JABRA_PROBE_ALERT_COOLDOWN )); then
        debug "suppressing mic-silent notification (cooldown active)"
        echo "$prev" > "$JABRA_ALERT_FLAG_FILE"
        return 0
    fi
    echo "$now" > "$JABRA_ALERT_COOLDOWN_FILE"
    id=$(notify_user_tracked critical "Jabra mic is silent" \
        "The buds connected but the mic is sending no audio. Hold the bud button 4 s to power it off, leave it in the closed case for 3 minutes, then take it out. (A quick case-cycle often does not clear this.)" \
        "$prev")
    echo "$id" > "$JABRA_ALERT_FLAG_FILE"
}

# probe_jabra_mic: runs in the background after a Jabra connect (see
# start_jabra_probe). Listens to the mic, confirms a "dead" result once, then
# alerts. Logs exactly one PROBE line per connect.
probe_jabra_mic() {
    trap 'probe_restore_sink_volume; rm -f "$JABRA_PROBE_WAV"; exit 0' TERM INT
    sleep "$JABRA_PROBE_DELAY"

    local src fixed verdict id
    src=$(jabra_probe_source)
    if [[ -z "$src" ]]; then
        log "PROBE: no Jabra mic source in PipeWire; mic check skipped"
        trap - TERM INT
        return 0
    fi

    fixed=$(ensure_jabra_mic_live "$src")
    if [[ "$fixed" == *unmuted* ]]; then
        notify_user normal "Jabra mic unmuted" \
            "The Jabra mic was muted when the buds connected, so audio-switcher unmuted it. You are live."
    fi

    probe_snapshot_sink_volume
    probe_jabra_mic_once "$src"
    if [[ "${PROBE_RESULT%% *}" == dead ]]; then
        sleep "$JABRA_PROBE_RETRY_DELAY"
        probe_jabra_mic_once "$src"
    fi
    verdict="${PROBE_RESULT%% *}"
    log "PROBE: jabra mic $PROBE_RESULT fixed=${fixed:-none}"

    case "$verdict" in
        dead)
            notify_jabra_mic_dead
            ;;
        ok)
            if [[ -f "$JABRA_ALERT_FLAG_FILE" ]]; then
                id=$(cat "$JABRA_ALERT_FLAG_FILE" 2>/dev/null || true)
                rm -f "$JABRA_ALERT_FLAG_FILE" "$JABRA_ALERT_COOLDOWN_FILE"
                notify_user normal "Jabra mic working again" "The buds' mic is sending audio." "$id"
            fi
            ;;
    esac

    sleep "$JABRA_PROBE_VOLUME_SETTLE"
    probe_restore_sink_volume
    trap - TERM INT
}

# Run one probe in the background (replacing any probe already running), so
# the HID event loop is never blocked.
start_jabra_probe() {
    stop_jabra_probe
    probe_jabra_mic &
    JABRA_PROBE_PID=$!
}

stop_jabra_probe() {
    local pid="$JABRA_PROBE_PID"
    JABRA_PROBE_PID=""
    [[ -n "$pid" ]] || return 0
    # Only signal our own child: the pid may have been reused since it exited.
    if [[ "$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)" == "$$" ]]; then
        kill -TERM "$pid" 2>/dev/null || true
        # bash runs the probe's TERM trap only after its current foreground
        # command (sleep / recorder) ends, so end that too.
        pkill -TERM -P "$pid" 2>/dev/null || true
    fi
    return 0
}

# --- Main Event Loop ---
# Discovers both dongles' hidraw devices and monitors whichever are present
# concurrently, merging their tagged events. Any subset of dongles may be
# absent. On a device event, update its state, re-resolve the priority ladder,
# and apply the matched defaults.
handle_event() {
    local device="$1" state="$2"
    case "$state" in
        connected)
            log "EVENT: $device connected"
            sleep "$SETTLE_DELAY"
            set_device_state "$device" connected
            apply_priority
            show_status
            # Newly connected devices are prone to broken pipes — enter hunt mode.
            log "HUNT: entering hunt mode after $device connect"
            echo "$(date +%s) hunt" > "$PW_COOLDOWN_FILE"
            # The Jabra mic can relink delivering pure zeros; check it.
            if [[ "$device" == jabra ]]; then
                start_jabra_probe
            fi
            ;;
        disconnected)
            log "EVENT: $device disconnected"
            if [[ "$device" == jabra ]]; then
                stop_jabra_probe
            fi
            sleep "$SETTLE_DELAY"
            set_device_state "$device" disconnected
            apply_priority
            show_status
            ;;
    esac
}

event_loop() {
    while true; do
        local btd_hidraw jabra_hidraw
        btd_hidraw=$(find_hidraw 2>/dev/null || true)
        jabra_hidraw=$(find_jabra_hidraw 2>/dev/null || true)

        if [[ -z "$btd_hidraw" && -z "$jabra_hidraw" ]]; then
            debug "No headset dongles found; re-checking in 10s"
            sleep 10
            continue
        fi

        log "Starting HID monitors (btd=${btd_hidraw:-none} jabra=${jabra_hidraw:-none})"
        show_status

        while IFS= read -r event; do
            case "$event" in
                btd:connected)     handle_event btd connected ;;
                btd:disconnected)  handle_event btd disconnected ;;
                jabra:connected)   handle_event jabra connected ;;
                jabra:disconnected) handle_event jabra disconnected ;;
                *:error:*)         log "HID error: ${event#*error:}" ;;
                *)                 debug "unknown event: $event" ;;
            esac
        done < <(
            {
                [[ -n "$btd_hidraw" ]] && monitor_hidraw "$btd_hidraw" | sed -u 's/^/btd:/' &
                [[ -n "$jabra_hidraw" ]] && monitor_jabra_hidraw "$jabra_hidraw" | sed -u 's/^/jabra:/' &
                wait
            }
        )

        # Monitor(s) exited — a dongle was likely unplugged. Re-discover.
        log "HID monitor(s) exited, waiting 2s before re-discovering..."
        sleep 2
    done
}

# --- Signal Handling ---
cleanup() {
    trap - SIGTERM SIGINT
    echo ""
    log "Shutting down audio-switcher"
    if [[ -n "${HEALTH_PID:-}" ]]; then
        kill "$HEALTH_PID" 2>/dev/null || true
    fi
    if [[ -n "${SLEEP_PID:-}" ]]; then
        kill "$SLEEP_PID" 2>/dev/null || true
    fi
    stop_jabra_probe
    jobs -p | xargs -r kill 2>/dev/null || true
    rm -f "$STATE_FILE" "$PW_COOLDOWN_FILE" "$PW_NOTIFY_COOLDOWN_FILE" \
        "$JABRA_ALERT_FLAG_FILE" "$JABRA_ALERT_COOLDOWN_FILE" "$JABRA_PROBE_WAV"
    exit 0
}

# --- probe-mic Subcommand ---
# One immediate probe of the Jabra mic, for calibration. Reports only: never
# unmutes, changes volume, retries or notifies.
do_probe_mic() {
    local src
    src=$(jabra_probe_source)
    if [[ -z "$src" ]]; then
        echo "no Jabra mic source in PipeWire (are the buds connected?)"
        return 1
    fi
    if [[ "$(jabra_mic_state "$src")" == muted ]]; then
        echo "muted vol=$(jabra_mic_volume "$src") (mic is muted; unmute it to probe, nothing recorded)"
        return 0
    fi
    probe_jabra_mic_once "$src"
    echo "$PROBE_RESULT"
}

# --- Fix Subcommand ---
do_fix() {
    local error_count
    error_count=$(journalctl --user -u pipewire --since "-120s" --no-pager 2>/dev/null \
        | grep -c "Broken pipe" || true)

    if (( error_count > 0 )); then
        log "FIX: $error_count broken-pipe errors in last 120s, restarting PipeWire"
        systemctl --user restart pipewire pipewire-pulse wireplumber
        sleep 2
        apply_priority
        log "FIX: recovery complete"
        show_status
        notify_pw_restart "Manual fix: PipeWire restarted ($error_count broken pipe errors)"
    else
        log "FIX: no broken-pipe errors in last 120s — audio appears healthy"
        show_status
        notify_user normal "Audio Healthy" "No broken pipe errors detected"
    fi
}

# --- Main ---
main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose) VERBOSE=true; shift ;;
            fix) ACTION="fix"; shift ;;
            probe-mic) ACTION="probe-mic"; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    if [[ "$ACTION" == "probe-mic" ]]; then
        do_probe_mic
        exit $?
    fi

    trap cleanup SIGTERM SIGINT

    if [[ "$ACTION" == "fix" ]]; then
        do_fix
        exit 0
    fi

    log "audio-switcher starting (verbose=$VERBOSE)"
    log "  Priority:        Jabra buds > BTD-800 > S/PDIF"
    log "  BTD-800 match:   *${BTD_USB_ID}*"
    log "  Jabra match:     *${JABRA_SINK_MATCH}*"
    log "  S/PDIF fallback: $SPDIF_SINK"
    log "  BTD-800 hidraw:  $(find_hidraw 2>/dev/null || echo '(not present)')"
    log "  Jabra hidraw:    $(find_jabra_hidraw 2>/dev/null || echo '(not present)')"

    echo ""

    # Start PipeWire health monitor in background
    pipewire_health_loop &
    HEALTH_PID=$!
    log "  PW health monitor PID: $HEALTH_PID"

    # Start sleep/resume monitor in background
    sleep_resume_loop &
    SLEEP_PID=$!
    log "  Sleep/resume monitor PID: $SLEEP_PID"

    event_loop
}

# Only run main when executed directly — sourcing (e.g. from tests) just loads
# the functions.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
